# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN & TELEGRAM_CHAT_ID: Used by scripts/telegramBot.ts for automated Daily Panchangam & Horoscope cards.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHANNEL_OR_CHAT_ID"

# WHATSAPP AUTOMATION (Official Meta Cloud API or Free CallMeBot):
WHATSAPP_PHONE="918977986166"
CALLMEBOT_API_KEY="" # Free personal WhatsApp API key (send 'I allow callmebot to send me messages' to +34 644 44 20 46)
META_WA_TOKEN="" # Meta WhatsApp Cloud API Token (developers.facebook.com)
META_PHONE_ID="" # Meta WhatsApp Phone Number ID
WHATSAPP_VERIFY_TOKEN="telugujyothisham_wa_verify_2026"

# YOUTUBE SHORTS AUTO-UPLOAD (OAuth2 Refresh Token):
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
YOUTUBE_PRIVACY_STATUS="public" # public | unlisted | private
REEL_PUBLISH_VARIANTS="panchangam_te,rashi_te,panchangam_en,rashi_en"

# FACEBOOK PAGE & INSTAGRAM REELS AUTO-UPLOAD (Meta Graph API):
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_TOKEN=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""
CLOUDINARY_CLOUD_NAME="" # Optional free hosting for Instagram Reels video_url
CLOUDINARY_UPLOAD_PRESET=""

# LINKEDIN & MAKE.COM / ZAPIER WEBHOOK:
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_PERSON_URN=""
SOCIAL_WEBHOOK_URL=""

