{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "telugujyothisham.com"
        }
      ],
      "destination": "https://www.telugujyothisham.com/:path*",
      "permanent": true
    },
    {
      "source": "/neti-panchangam",
      "destination": "/panchangam",
      "permanent": true
    },
    {
      "source": "/today-panchangam-in-telugu",
      "destination": "/panchangam",
      "permanent": true
    },
    {
      "source": "/ee-roju-panchangam",
      "destination": "/panchangam",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/awards",
      "destination": "/about",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/panchangam/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon.*\\.png|apple-touch-icon.*\\.png|ganapathi-favicon\\.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(llms\\.txt|llms-full\\.txt|ffe9fa91702c937109ee200641e2921e\\.txt|ads\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/BingSiteAuth\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/telegram-webhook",
      "destination": "/api/telegram-webhook"
    },
    {
      "source": "/api/whatsapp-webhook",
      "destination": "/api/whatsapp-webhook"
    },
    {
      "source": "/api/ssr",
      "destination": "/api/ssr"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
